# AppDemo.live environment variables. Names only; never commit values.
# The app runs without any of these: auth pages show a setup notice and providers use labeled mocks.

# APP. Public base URL; Better Auth uses it for sign-in links. Default: http://localhost:3000
APP_URL=

# DATABASE (Neon Postgres). Server only. Use a Neon dev branch or local Postgres for development.
# Pooled connection string; also used by `npm run db:migrate` / `npm run db:rollback`.
DATABASE_URL=

# AUTH (Better Auth, email magic links). Server only. At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# OPENAI (Phase 3). Without a key the app uses clearly labeled placeholder plans. See docs/AI.md.
OPENAI_API_KEY=
# Optional. Any model that supports structured outputs. Default: gpt-4o-mini
OPENAI_MODEL=

# STRIPE (Phase 2). Setup and local webhook testing: docs/STRIPE_CHECKOUT.md
# Server only. sk_test_... for test mode. With no key, checkout is disabled (mock billing).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (whsec_...). From `stripe listen` locally, or the dashboard endpoint in hosted envs.
STRIPE_WEBHOOK_SECRET=
# Only needed if the key is sk_live_...; must be exactly "true" or live keys fall back to mock billing.
ALLOW_LIVE_PAYMENTS=
# Optional. Base URL used for Stripe success/cancel links; defaults to the request's host.
NEXT_PUBLIC_SITE_URL=
# Optional, currently unused (Checkout is Stripe-hosted, so no browser-side Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# BACKGROUND JOBS (Phase 3)
TRIGGER_SECRET_KEY=

# BROADCAST_PROVIDER (Phase 5, stubbed)
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=

# DM_PROVIDER (Phase 4, stubbed)
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=

# DISTRIBUTION_PROVIDER (Phase 7, stubbed)
BLOTATO_API_KEY=

# EMAIL (Resend) — sign-in links. Without both, dev logs links to the console and production
# refuses to send. EMAIL_FROM must be on a domain verified in Resend, e.g. "AppDemo <login@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# ABUSE PROTECTION (Phase 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OBSERVABILITY
LOG_LEVEL=
